# Settings for compose.yaml. Copy to .env and edit.

# "open": anyone who can reach the server can create an account.
# "invite": account creation requires INVITE_CODE (closed if it is empty).
# The Lume apps can't send an invite code yet, so they can only create
# accounts on an open server. See "Configuration" in ../README.md.
SIGNUP=open
INVITE_CODE=

# Public domain for the caddy profile (DNS must point at this host).
LUME_DOMAIN=cloud.example.com

# Host port of the server itself (bound to 127.0.0.1 only).
PORT=8787

# Reported by /healthz.
VERSION=docker
